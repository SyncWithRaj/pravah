{
  "name": "pravah-workspace",
  "private": true,
  "scripts": {
    "core": "pnpm --filter core start:dev",
    "edge": "pnpm --filter edge start:dev",
    "format": "pnpm -r format",
    "lint": "pnpm -r lint",
    "fix": "pnpm -r format && pnpm -r lint",
    "build": "pnpm -r build",
    "build:all": "pnpm run fix && pnpm run build"
  }
}
