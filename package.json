{
  "name": "pravah-workspace",
  "private": true,
  "scripts": {
    "core": "pnpm --filter core start:dev",
    "edge": "pnpm --filter edge start:dev",
    "format": "pnpm --filter core format",
    "lint": "pnpm --filter core lint",
    "fix": "pnpm --filter core format && pnpm --filter core lint",
    "build": "pnpm -r build",
    "build:all": "pnpm run fix && pnpm run build",
    "dashboard": "python3 -m http.server 8080 --directory dashboard"
  }
}
