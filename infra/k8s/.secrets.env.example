# Example secrets file for kustomize secretGenerator
# Copy to infra/k8s/.secrets.env and populate with production values
POSTGRES_USER=pravah_admin
POSTGRES_PASSWORD=replace_with_secure_db_password
POSTGRES_DB=pravah_db
DATABASE_URL=postgresql://pravah_admin:replace_with_secure_db_password@pravah-postgres.pravah-system.svc.cluster.local:5432/pravah_db?schema=public&sslmode=disable
MINIO_ACCESS_KEY=admin_minio
MINIO_SECRET_KEY=replace_with_secure_minio_key
JWT_SECRET=replace_with_production_jwt_secret
JWT_REFRESH_SECRET=replace_with_production_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_API_KEY=replace_with_production_internal_key
INTERNAL_SERVICE_SECRET=replace_with_production_internal_secret
EDGE_URL_SIGNING_SECRET=replace_with_production_edge_signing_secret
