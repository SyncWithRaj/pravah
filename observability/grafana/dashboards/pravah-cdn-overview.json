    {
      "id": 7,
      "title": "Edge Delivery: RAM Hits vs Origin Misses vs Peer Fills",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(pravah_edge_cache_hits_total[1m]))",
          "legendFormat": "RAM Cache Hit (Sub-ms)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pravah_edge_cache_misses_total[1m]))",
          "legendFormat": "Origin Fetch Miss (Origin Fill)",
          "refId": "B"
        },
        {
          "expr": "sum(rate(pravah_edge_peer_fetches_total[1m]))",
          "legendFormat": "Tiered Peer-to-Peer Cache Fill",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineInterpolation": "smooth",
            "stacking": {
              "mode": "none"
            }
          }
        }
      }
    },
