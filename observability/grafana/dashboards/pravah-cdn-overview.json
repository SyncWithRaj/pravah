    {
      "id": 1,
      "title": "Cache Hit Ratio (Origin Offload)",
      "type": "gauge",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "((sum(rate(pravah_edge_cache_hits_total[5m])) or vector(0)) / ((sum(rate(pravah_edge_cache_hits_total[5m])) or vector(0)) + (sum(rate(pravah_edge_cache_misses_total[5m])) or vector(0)) + 0.00001)) * 100",
          "legendFormat": "Hit Ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 50
              },
              {
                "color": "#56A64B",
                "value": 80
              }
            ]
          }
        }
      }
    },
