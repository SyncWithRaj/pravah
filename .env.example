# Pravah CDN — Environment Variables Template
# Copy this file to .env and fill in your values
# Never commit .env to Git — only commit .env.example

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin_postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=pravah_db

# ─── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_a_strong_redis_password

# ─── MinIO (S3-Compatible Storage) ───────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=admin_minio
MINIO_SECRET_KEY=minio_password
MINIO_BUCKET_NAME=pravah-origin
MINIO_USE_SSL=false

# ─── App Config ───────────────────────────────────────────────
APP_PORT=3000
NODE_ENV=development

# ─── JWT Auth ─────────────────────────────────────────────────
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── Internal Service HMAC ────────────────────────────────────
INTERNAL_SERVICE_SECRET=replace_with_a_strong_internal_service_secret

# ─── Edge URL HMAC Signing ─────────────────────────────────────
EDGE_URL_SIGNING_SECRET=replace_with_a_strong_edge_url_signing_secret

# ─── Kafka / Redpanda SASL Authentication ───────────────────────
KAFKA_BROKERS=localhost:19092
KAFKA_ADMIN_PASSWORD=replace_with_a_strong_kafka_admin_password
KAFKA_SASL_USERNAME=pravah-core
KAFKA_SASL_PASSWORD=replace_with_a_strong_kafka_sasl_password
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_EDGE_SASL_USERNAME=pravah-edge
KAFKA_EDGE_SASL_PASSWORD=replace_with_a_strong_edge_kafka_password

